# Beatlab configuration (copy to .env or export in your deployment)

BEATLAB_ADDR=0.0.0.0:4533
BEATLAB_DATA=./data
BEATLAB_CACHE_GB=5.0
# BEATLAB_ORIGIN=https://music.example.com
# ADMIN_USERNAME=your-admin-username

# ---- Optional OpenAI-compatible AI curator --------------------------------
# Point this at any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama,
# LM Studio, a free inference provider, etc.). The assistant is the primary
# curator for upcoming/radio, made-for-you rails, quick picks, Explore,
# instant mixes and search re-ranking. All of its work happens in background
# tasks; live requests only read cached plans from SQLite, so search speed is
# never affected by model latency.
BEATLAB_LLM_API_KEY=
BEATLAB_LLM_BASE_URL=https://api.openai.com/v1
BEATLAB_LLM_MODEL=gpt-4o-mini
# Auto-enabled when BEATLAB_LLM_API_KEY is set. Force on/off explicitly:
# BEATLAB_LLM_ENABLED=1
# Per-call deadline in milliseconds (background calls only):
# BEATLAB_LLM_TIMEOUT_MS=12000
# Some cheap endpoints don't support response_format=json_object:
# BEATLAB_LLM_JSON_MODE=1
# BEATLAB_LLM_MAX_TOKENS=900
# BEATLAB_LLM_TEMPERATURE=0.2

# Optional background web research: when the model says it is unsure about a
# fact (artist era, genre origin, release year), it may request up to two
# search queries. Keyless by default via DuckDuckGo HTML; results are cached
# for a week and never fetched on a user request path.
# BEATLAB_LLM_RESEARCH=1
# BEATLAB_LLM_SEARCH_URL=https://html.duckduckgo.com/html/?q={q}
# BEATLAB_LLM_RESEARCH_RESULTS=5
# BEATLAB_LLM_RESEARCH_TIMEOUT_MS=6000

# Aliases also accepted: OPENAI_API_KEY, OPENAI_BASE_URL / OPENAI_API_BASE,
# OPENAI_MODEL.
